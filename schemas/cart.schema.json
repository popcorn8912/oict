{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/popcorn8912/oict/schemas/cart.schema.json",
  "title": "OICT Cart (PUT /v1/sessions/:id/cart body)",
  "type": "object",
  "required": [
    "lines"
  ],
  "properties": {
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "sceneObjectId",
          "sku",
          "variantId",
          "quantity"
        ],
        "properties": {
          "sceneObjectId": {
            "type": "string",
            "minLength": 1
          },
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "variantId": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      }
    }
  }
}
